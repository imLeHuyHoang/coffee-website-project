# ==============================================================================
# Frontend Environment Variables
# ==============================================================================
# CACH SU DUNG:
#   1. Copy file nay thanh .env:
#      cp .env.example .env
#
#   2. Sua gia tri API URL (lay tu terraform output hoac AWS Console)
#
#   3. KHONG commit .env vao git! (da co trong .gitignore)
#
# TU DONG HOA:
#   cd terraform && .\scripts\sync-env.ps1
#   Script se tu dong doc terraform outputs va ghi vao .env
# ==============================================================================

# ==============================================================================
# Frontend Environment Variables
# ==============================================================================
# CACH SU DUNG:
#   Cach 1 (thu cong): Copy file nay thanh .env va sua gia tri
#     cp .env.example .env
#
#   Cach 2 (tu dong): Chay sync-env script sau terraform apply
#     cd terraform && .\scripts\sync-env.ps1
# ==============================================================================

# API Gateway URL - Frontend se goi API backend qua URL nay
# Lay tu: cd terraform && terraform output -raw api_url
VITE_API_BASE_URL=https://YOUR-API-ID.execute-api.ap-southeast-1.amazonaws.com/prod
